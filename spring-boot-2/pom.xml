<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.baomidou</groupId>
        <artifactId>dynamic-datasource-samples</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>spring-boot-2-samples</artifactId>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>1.8</java.version>
        <mybatis-spring-boot-starter.version>2.3.1</mybatis-spring-boot-starter.version>
        <!--Boot 2.7.x 已 EOL，其 BOM 管理 H2 2.1.x，这里显式使用较新的 2.2.x。-->
        <h2.version>2.2.224</h2.version>
        <spring-boot-dependencies.version>2.7.18</spring-boot-dependencies.version>
        <!--spring-boot-2 与 spring-boot-4 统一使用 testcontainers 2.0.5。
            2.x 经 docker-java 3.7.1 要求较新的 Jackson，全家由 jackson-bom 显式 import 统一锁定；
            又经 commons-compress 用到 lang3 3.14+ 的 ArrayFill，一并显式升级。
            两处 pin 都必须保持在 spring-boot-dependencies 之前（first import wins）。-->
        <testcontainers-bom.version>2.0.5</testcontainers-bom.version>
        <jackson-bom.version>2.20.1</jackson-bom.version>
        <!--testcontainers 2.x 经 commons-compress 用到 lang3 3.14+ 的 ArrayFill，Boot 2.7 只给 3.12.0，这里显式升级。-->
        <commons-lang3.version>3.17.0</commons-lang3.version>
    </properties>

    <modules>
        <!--shardingsphere-jdbc-4.x-spring-sample 无法迁移到 Spring Boot 4，
        ShardingSphere 4.1.1 仅支持 spring.factories 注册、
        且二进制上只兼容 SnakeYAML 1.x，该版本线官方已不再维护。-->
        <module>shardingsphere-jdbc-4.x-spring-sample</module>
        <module>shardingsphere-jdbc-5.x-spring-sample</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!--必须放在 spring-boot-dependencies 之前：first import wins，全家锁定同一 Jackson 版本，避免偏斜。-->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>dynamic-datasource-spring-boot-starter</artifactId>
                <version>${ds.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot-dependencies.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-ui</artifactId>
                <version>1.7.0</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
