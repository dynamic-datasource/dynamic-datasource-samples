<additionalHeaders>
    <!--与 license-maven-plugin 内置的 SCRIPT_STYLE 相同，只是跳过的是 Dockerfile 的解析器指令（如 # syntax=）：
        它们必须写在文件最前面，license 头只能放在其后。-->
    <dockerfile_style>
        <firstLine>#</firstLine>
        <beforeEachLine># </beforeEachLine>
        <endLine>#EOL</endLine>
        <skipLine>^#\s*(syntax|escape|check)\s*=.*$</skipLine>
        <firstLineDetectionPattern>#.*$</firstLineDetectionPattern>
        <lastLineDetectionPattern>#.*$</lastLineDetectionPattern>
        <allowBlankLines>false</allowBlankLines>
        <isMultiline>false</isMultiline>
        <padLines>false</padLines>
    </dockerfile_style>
</additionalHeaders>
