<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.baomidou</groupId>
    <artifactId>dynamic-datasource-samples</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--默认值，各 spring-boot-* 聚合模块会按自己的 Boot 版本线覆盖。-->
        <java.version>17</java.version>
        <!--JDK 27 要求 Lombok 1.18.48+，而各版本线的 Spring Boot BOM（目前最多管理到 1.18.46），
            因此在根模块统一定义并覆盖，各子模块的 Lombok 依赖与注解处理器均使用该版本。-->
        <lombok.version>1.18.48</lombok.version>
        <ds.version>4.5.0</ds.version>
        <druid.version>1.2.28</druid.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <license-maven-plugin.version>4.2</license-maven-plugin.version>
        <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
        <google-java-format.version>1.36.1</google-java-format.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>14.3.0</checkstyle.version>
    </properties>

    <modules>
        <module>spring-boot-2</module>
        <module>spring-boot-3</module>
        <module>spring-boot-4</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <!--生成方法参数名（与 spring-boot-starter-parent 的默认行为一致）。
                        新版 javac 不再把未使用的参数保留在 LocalVariableTable 中，
                        而 SpEL 的 `#paramName` 解析（例如 @DS("#tenantName")）依赖参数名。-->
                    <parameters>true</parameters>
                    <!--Lombok 版本交由各模块 dependencyManagement（Spring Boot BOM 或显式覆盖）决定，
                        maven-compiler-plugin 3.12.0+ 支持不写版本（MCOMPILER-391）。-->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <configuration>
                    <header>${maven.multiModuleProjectDirectory}/license.txt</header>
                    <includes>
                        <include>src/main/java/**</include>
                        <include>src/test/java/**</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--代码格式化：`spotless:apply` 一键修复，`spotless:check` 在 CI 校验。
                使用 google-java-format 的 AOSP 风格（4 空格缩进），与现有代码保持一致。
                注意：google-java-format 1.30+ 需要 JDK 21+ 运行，且版本需与 Spotless 内嵌 glue 兼容，不要随意升级
                （1.37.0 改过 JavaFormatterOptions.Style 的 API，Spotless 3.10.4 尚不兼容）。
                通配符 `*` 导入由 Checkstyle 的 AvoidStarImport 拦截，需要手工展开。-->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
            </plugin>
            <!--代码检查：Checkstyle 官方的 google_checks.xml。
                与格式化冲突或示例项目不适用的规则在 config/checkstyle/suppressions.xml 中抑制。
                注意：Checkstyle 14 需要 JDK 21+ 运行。-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>google_checks.xml</configLocation>
                    <suppressionsLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/suppressions.xml</suppressionsLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <!--google_checks.xml 中规则的默认级别是 warning，这里以 warning 作为失败阈值。-->
                    <violationSeverity>warning</violationSeverity>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
