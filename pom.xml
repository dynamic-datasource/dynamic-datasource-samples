<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.baomidou</groupId>
    <artifactId>dynamic-datasource-samples</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--默认值，各 spring-boot-* 聚合模块会按自己的 Boot 版本线覆盖。-->
        <java.version>17</java.version>
        <!--JDK 27 要求 Lombok 1.18.48+，而各版本线的 Spring Boot BOM（目前最多管理到 1.18.46），
            因此在根模块统一定义并覆盖，各子模块的 Lombok 依赖与注解处理器均使用该版本。-->
        <lombok.version>1.18.48</lombok.version>
    </properties>

    <modules>
        <module>spring-boot-2</module>
        <module>spring-boot-3</module>
        <module>spring-boot-4</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <!--生成方法参数名（与 spring-boot-starter-parent 的默认行为一致）。
                        新版 javac 不再把未使用的参数保留在 LocalVariableTable 中，
                        而 SpEL 的 `#paramName` 解析（例如 @DS("#tenantName")）依赖参数名。-->
                    <parameters>true</parameters>
                    <!--Lombok 版本交由各模块 dependencyManagement（Spring Boot BOM 或显式覆盖）决定，
                        maven-compiler-plugin 3.12.0+ 支持不写版本（MCOMPILER-391）。-->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>4.2</version>
                <configuration>
                    <header>${maven.multiModuleProjectDirectory}/license.txt</header>
                    <includes>
                        <include>src/main/java/**</include>
                        <include>src/test/java/**</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
